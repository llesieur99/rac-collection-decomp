# The target, the disc tree, the executables and the receipts
#
# Nothing game-derived is committed: the disc tree, the retail executables and
# the manifests of the local copies stay in the private workspace.

# Local target and extracted material
source/
disc/
baserom/
work/pkg/
work/eboot/
work/elf/
work/analysis/*
work/lots/*
work/gate/
work/*.pkg
work/*.rap
work/*.klic
work/*.elf
work/*.bin
work/*.self
work/*.sprx
work/*.prx
work/*.edat
work/*.sdat
work/*.png
work/*.wav
work/*.at3
work/*.m4a
!work/README.md
!work/templates/
!work/lots/.gitkeep
!work/analysis/.gitkeep

# Key material and disc keys never belong here
*.dkey
*.dkeys
*.rap
*.klic
*key_vault*
*keytable*

# Generic binary artefacts
*.pkg
*.iso
*.elf
*.bin
*.self
*.sprx
*.prx
*.o
*.a
*.map
*.log
*.dmp
*.core

# Disassembly and listings
*.asm
*.lst
*.s
*.dis
*.objdump
*.ghidra
*.gzf
*.gpr
*.rep/

# Build output and scratch
build/
.venv/
venv/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
